---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const pages = await getCollection("pages");
  const existingStaticRoutes = new Set([
    "about-us-new",
    "contact",
    "events-for-corporates-families",
    "glamping-location-cyprus",
    "glamping-resort-cyprus",
    "kids-playground-activities",
    "mountain-side-accommodations-in-cyprus",
    "mountain-side-accomodations-in-cyprus",
  ]);

  return pages
    .filter((page) => !existingStaticRoutes.has(page.data.slug))
    .map((page) => ({
      params: { slug: page.data.slug },
      props: { page },
    }));
}

const { page } = Astro.props;
const { Content } = await render(page);
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <h1>{page.data.title}</h1>
  <Content />
</BaseLayout>

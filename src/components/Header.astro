    div.elementor-8679 .elementor-nav-menu--dropdown li.menu-item a.elementor-item,
    .elementor-nav-menu--dropdown li.menu-item a.elementor-item {
      display: block !important;
      padding: 14px 20px !important;
      font-family: "Poppins", Sans-serif !important;
      font-size: 15px !important;
      font-weight: 500 !important;
      color: #1A2C1D !important;
      text-decoration: none !important;
      transition: color 0.2s ease, background-color 0.2s ease !important;
    }
    div.elementor-8679 .elementor-nav-menu--dropdown li.menu-item a.elementor-item:hover,
    div.elementor-8679 .elementor-nav-menu--dropdown li.menu-item.current-menu-item a.elementor-item,
    div.elementor-8679 .elementor-nav-menu--dropdown li.menu-item.current_page_item a.elementor-item,
    div.elementor-8679 .elementor-nav-menu--dropdown li.menu-item a.elementor-item.elementor-item-active {
      color: #D57800 !important;
    }
    div.elementor-8679 .elementor-nav-menu--dropdown li.logocentral,
    .elementor-nav-menu--dropdown li.logocentral {
      padding: 12px 20px !important;
      text-align: center !important;
      width: 100% !important;
    }
    div.elementor-8679 .elementor-nav-menu--dropdown li.logocentral a,
    .elementor-nav-menu--dropdown li.logocentral a {
      display: inline-block !important;
      padding: 0 !important;
    }
    div.elementor-8679 .elementor-nav-menu--dropdown li.logocentral img,
    .elementor-nav-menu--dropdown li.logocentral img {
      width: auto !important;
      display: inline-block !important;
      margin: 0 auto !important;
    }
  }

  /* Desktop active navbar link colors */
  #masthead .elementor-nav-menu--main .elementor-item.elementor-item-active,
  #masthead .elementor-nav-menu--main li.current-menu-item > a.elementor-item,
  #masthead .elementor-nav-menu--main li.current_page_item > a.elementor-item,
  #masthead .elementor-nav-menu--main .elementor-item:hover {
    color: #D57800 !important;
  }
</style>

<script is:inline>
  function updateActiveNav() {
    const currentPath = (window.location.pathname || '').replace(/\/+$/, '') || '/';
    const menuLinks = document.querySelectorAll('#masthead .elementor-nav-menu a');
    menuLinks.forEach((link) => {
      const href = link.getAttribute('href');
      if (!href) return;
      const linkPath = href.replace(/\/+$/, '') || '/';
      const li = link.closest('li');
      if (linkPath === currentPath) {
        link.classList.add('elementor-item-active');
        link.setAttribute('aria-current', 'page');
        if (li) {
          li.classList.add('current-menu-item', 'current_page_item');
        }
      } else {
        link.classList.remove('elementor-item-active');
        link.removeAttribute('aria-current');
        if (li) {
          li.classList.remove('current-menu-item', 'current_page_item');
        }
      }
    });
  }

  function setupMobileMenu() {
    const toggles = document.querySelectorAll('.elementor-menu-toggle');
    toggles.forEach((toggle) => {
      if (toggle.dataset.menuAttached) return;
      toggle.dataset.menuAttached = 'true';

      toggle.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const navContainer = toggle.closest('.elementor-widget-nav-menu') || document;
        const dropdown = navContainer.querySelector('.elementor-nav-menu--dropdown');
        const isClosed = !toggle.classList.contains('elementor-active');

        if (isClosed) {
          toggle.classList.add('elementor-active');
          toggle.setAttribute('aria-expanded', 'true');
          if (dropdown) {
            const masthead = document.querySelector('#masthead');
            const mastheadBottom = masthead ? masthead.getBoundingClientRect().bottom : 70;
            dropdown.style.top = Math.max(0, mastheadBottom) + 'px';
            dropdown.classList.add('elementor-active');
            dropdown.style.display = 'block';
            dropdown.setAttribute('aria-hidden', 'false');
          }
        } else {
          toggle.classList.remove('elementor-active');
          toggle.setAttribute('aria-expanded', 'false');
          if (dropdown) {
            dropdown.classList.remove('elementor-active');
            dropdown.style.display = 'none';
            dropdown.setAttribute('aria-hidden', 'true');
          }
        }
      });
    });

    // Close when clicking outside
    document.addEventListener('click', (e) => {
      if (!e.target.closest('#masthead') && !e.target.closest('.elementor-nav-menu--dropdown')) {
        document.querySelectorAll('.elementor-menu-toggle.elementor-active').forEach(t => {
          t.classList.remove('elementor-active');
          t.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.elementor-nav-menu--dropdown.elementor-active').forEach(d => {
          d.classList.remove('elementor-active');
          d.style.display = 'none';
          d.setAttribute('aria-hidden', 'true');
        });
      }
    });

    // Close when clicking any dropdown menu link
    const links = document.querySelectorAll('.elementor-nav-menu--dropdown a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        document.querySelectorAll('.elementor-menu-toggle').forEach(t => {
          t.classList.remove('elementor-active');
          t.setAttribute('aria-expanded', 'false');
        });
        document.querySelectorAll('.elementor-nav-menu--dropdown').forEach(d => {
          d.classList.remove('elementor-active');
          d.style.display = 'none';
          d.setAttribute('aria-hidden', 'true');
        });
      });
    });
  }

  function initHeader() {
    updateActiveNav();
    setupMobileMenu();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHeader);
  } else {
    initHeader();
  }
  window.addEventListener('load', initHeader);
  window.addEventListener('resize', setupMobileMenu);
</script>

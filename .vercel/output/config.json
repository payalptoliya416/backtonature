			"dest": "_render"
		},
		{
			"src": "^/accommodation/couples-family-cabin-swimming-pool/?$",
			"dest": "_render"
		},
		{
			"src": "^/accommodation/mountain-wood-cabin-kids-playground-cyprus/?$",
			"dest": "_render"
		},
		{
			"src": "^/accommodation/wooden-cabin-bbq-pool-for6/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/send-email/?$",
			"dest": "_render"
		},
		{
			"src": "^/blog(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/contact/?$",
			"dest": "_render"
		},
		{
			"src": "^/events-for-corporates-families/?$",
			"dest": "_render"
		},
		{
			"src": "^/glamping-location-cyprus/?$",
			"dest": "_render"
		},
		{
			"src": "^/glamping-resort-cyprus/?$",
			"dest": "_render"
		},
		{
			"src": "^/kids-playground-activities/?$",
			"dest": "_render"
		},
		{
			"src": "^/mountain-side-accommodations-in-cyprus/?$",
			"dest": "_render"
		},
		{
			"src": "^/mountain-side-accomodations-in-cyprus/?$",
			"dest": "_render"
		},
		{
			"src": "^/rank_math_schema(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/rm_content_editor(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^(?:/(.*?))?/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}